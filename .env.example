# NSW Fuel API (api.nsw.gov.au) client id/secret -- NOT read from here by
# anything. They go in connector/configuration.json instead (see
# connector/configuration.json.example and connector/README.md), which is
# what both `fivetran debug` (local testing) and `fivetran deploy` (which
# uploads that file's contents to Fivetran as the connector's stored
# runtime config) actually read. Register at https://api.nsw.gov.au and
# subscribe to the Fuel Check Price Reporting product -- see
# docs/data_source.md for the full steps.

# Fivetran API key, used only by `fivetran deploy` to push the connector to
# Fivetran -- never committed, never read by the connector at runtime. Use
# the combined base64-encoded {api-key}:{api-secret} string Fivetran shows
# you (from your profile icon -> API Key -> Generate API key), not the raw
# key or secret alone.
FIVETRAN_API_KEY=

# GCP project hosting the BigQuery datasets
GCP_PROJECT_ID=

# Path to the nsw-fuel-dbt-runner service-account JSON key (BigQuery Data
# Viewer on `raw`, Data Editor on `staging`/`marts`). Used by dbt's `dev`
# profile target for local runs -- deliberately a separate identity from
# Fivetran's own BigQuery service account and from the GitHub Actions `ci`
# service account, so a leaked key in any one place can't reach what the
# others touch. Never commit the actual key file.
DBT_KEYFILE=

# BigQuery dataset/location defaults. BQ_RAW_DATASET is NOT necessarily
# "raw" -- confirmed against a real Fivetran sync, the Connector SDK
# integration names the destination dataset after the *connection* name
# you choose when deploying (see connector/README.md), not the BigQuery
# destination's own "Dataset name" setting. Set this to whatever your
# connection is actually named.
BQ_RAW_DATASET=raw
BQ_LOCATION=australia-southeast1

# Path to the Google Sheets export service-account JSON key. This account
# is shared as an editor on the target Sheet only -- not on the whole
# Drive -- and is used by scripts/export_dashboard_snapshot.py (added when
# the export script is built).
GOOGLE_SHEETS_KEYFILE=

# The Google Sheet ID that scripts/export_dashboard_snapshot.py writes to
# (the long id in the Sheet's URL, between /d/ and /edit).
GOOGLE_SHEET_ID=
