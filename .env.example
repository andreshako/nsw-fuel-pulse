# NSW Fuel API (api.nsw.gov.au) -- OAuth2 client credentials. Register at
# https://api.nsw.gov.au and subscribe to the Fuel Check Price Reporting
# product (see docs/data_source.md for the full registration and
# subscription steps). Used locally to test the connector against the real
# API. The deployed Fivetran connector does NOT read this file -- it runs
# on Fivetran's own infrastructure and gets these same values from the
# connector's deployed configuration instead (see connector/README.md,
# added when the connector is built).
NSW_FUEL_API_CLIENT_ID=
NSW_FUEL_API_CLIENT_SECRET=

# Fivetran API key, used only by `fivetran deploy` to push the connector to
# Fivetran -- never committed, never read by the connector at runtime.
FIVETRAN_API_KEY=

# GCP project hosting the BigQuery datasets
GCP_PROJECT_ID=

# Path to the nsw-fuel-dbt-runner service-account JSON key (BigQuery Data
# Viewer on `raw`, Data Editor on `staging`/`marts`). Used by dbt's `dev`
# profile target for local runs -- deliberately a separate identity from
# Fivetran's own BigQuery service account and from the GitHub Actions `ci`
# service account, so a leaked key in any one place can't reach what the
# others touch. Never commit the actual key file.
DBT_KEYFILE=

# BigQuery dataset/location defaults
BQ_RAW_DATASET=raw
BQ_LOCATION=australia-southeast1

# Path to the Google Sheets export service-account JSON key. This account
# is shared as an editor on the target Sheet only -- not on the whole
# Drive -- and is used by scripts/export_dashboard_snapshot.py (added when
# the export script is built).
GOOGLE_SHEETS_KEYFILE=

# The Google Sheet ID that scripts/export_dashboard_snapshot.py writes to
# (the long id in the Sheet's URL, between /d/ and /edit).
GOOGLE_SHEET_ID=
